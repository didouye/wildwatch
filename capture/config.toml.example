# WildWatch -- example configuration
# Copy this file to ~/wildwatch/config.toml and adapt the values.
# Every section and key is optional; the defaults live in
# wildwatch_capture/config.py.

[camera]
# Capture resolution. On a RPi 2 v1.1 (CMA = 64 MB) the full sensor resolution
# 4608x2592 exceeds the DMA quota: the V4L2 driver always allocates 4 buffers
# (4 x 36 MB > 64 MB). 2304x1296 (3 MP, ~36 MB total) is plenty for identifying
# animals and stays well within budget.
capture_width = 2304
capture_height = 1296
# Low-resolution stream used by the motion detector
detection_width = 640
detection_height = 480
# Software rotation if the camera is not mounted upright (0, 90, 180, 270)
rotation = 0

[motion]
# Per-pixel luminance diff (0-255) above which a pixel is considered "changed"
pixel_threshold = 25
# Fraction of pixels that must have changed to trigger (0.02 = 2%)
area_threshold = 0.02
# Background adaptation speed (0 = never, 1 = new frame replaces background).
# Lower = more stable but slower to follow lighting changes.
background_alpha = 0.05
# Frames ignored at startup while the background stabilizes
warmup_frames = 30
# Minimum delay between two consecutive triggers
cooldown_seconds = 5.0

[capture]
# Photos captured per trigger
burst_count = 3
# Delay between photos within a burst
burst_interval_seconds = 0.5

[upload]
# WildWatch server URL
server_url = "http://192.168.0.21:8000"
# API key (empty = no auth, V0.2 dev mode)
api_key = ""
# Local queue directories
queue_dir = "~/wildwatch/queue"
sent_dir = "~/wildwatch/sent"
# Retry interval after a failure
retry_interval_seconds = 30.0
# Retention period for already-sent photos (days)
sent_retention_days = 7
# HTTP request timeout
request_timeout_seconds = 60.0
