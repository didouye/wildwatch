[Unit]
Description=WildWatch capture client (motion-triggered wildlife photo capture)
Documentation=https://github.com/didouye/wildwatch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dietpi
Group=dietpi

# The venv lives next to the checked-out code (~/wildwatch-src/capture/.venv)
# and the entry point installed by uv is named "wildwatch-capture".
WorkingDirectory=/home/dietpi/wildwatch-src/capture
ExecStart=/home/dietpi/wildwatch-src/capture/.venv/bin/wildwatch-capture --log-level INFO

# Restart on crash, but not in an infinite loop if everything is broken
# (for instance: camera missing at every boot).
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

# Logs go to the systemd journal (`journalctl -u wildwatch-capture -f`).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wildwatch-capture

# Light hardening.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# The service needs to write inside ~/wildwatch/ (queue, sent, dead, config)
# AND /run/wildwatch/ (status.json + preview.jpg, read by wildwatch-agent).
ReadWritePaths=/home/dietpi/wildwatch /run/wildwatch
PrivateTmp=true

[Install]
WantedBy=multi-user.target
