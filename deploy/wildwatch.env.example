# Copy this file to wildwatch.env, edit the values, then `docker compose up -d`.
# Never commit your real wildwatch.env.
#
# docker-compose.yml loads this file with `format: raw` so values are passed
# to the container verbatim. No need to escape the `$` in your bcrypt hash.

# Public DNS name pointing at this host. Used by Caddy for the
# Let's Encrypt certificate.
WILDWATCH_DOMAIN=wildwatch.example.com

# API key consumed by the RPi capture client. Generate with:
#   openssl rand -hex 32
WILDWATCH_API_KEY=replace-me-with-a-long-random-string

# Web auth (login form on /login). Leave WILDWATCH_WEB_PASSWORD_HASH
# empty to disable web auth (LAN/dev mode).
WILDWATCH_WEB_USER=admin

# Bcrypt hash. Generate with the helper baked into the image:
#   docker run --rm -it ghcr.io/didouye/wildwatch-server:latest \
#       python -m wildwatch_server.hash_password
# Paste the resulting `$2b$12$...` string verbatim, no escaping required.
WILDWATCH_WEB_PASSWORD_HASH=

# Used by itsdangerous to sign the session cookie. Generate with:
#   openssl rand -hex 32
WILDWATCH_SESSION_SECRET=replace-me-with-a-long-random-string
